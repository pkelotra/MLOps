# Electricity MLOps — Environment Configuration Template
# Copy this file to .env and adjust as needed.

# Model artifact path (local/Docker)
MODEL_ARTIFACT_PATH=artifacts/serving_pipeline.pkl

# MLflow tracking (used during training runs)
MLFLOW_TRACKING_URI=sqlite:///mlflow.db

# API server
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# Monitoring
REFERENCE_DATA_PATH=monitoring/reference.json
CURRENT_DATA_PATH=monitoring/current.json
DRIFT_THRESHOLD=0.20
